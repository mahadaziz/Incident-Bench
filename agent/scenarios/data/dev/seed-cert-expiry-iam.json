  "ground_truth": {
    "root_cause": "cert_expiry",
    "summary": "The TLS certificate for api.example.com expired at 2026-05-14T00:00:00Z. Automatic renewal had been failing daily since 2026-05-10 because a least-privilege IAM cleanup on 2026-05-09 removed the Route53 permissions the DNS-01 challenge needs. The failures were only logged as warnings (ALERT_ON_FAILURE=false). The api-gateway v7.3.0 deploy an hour earlier and the reporting-batch CPU spike at midnight are coincidental.",
    "affected_service": "api-gateway",
    "required_evidence": ["log-001", "log-002", "log-005"],
    "distractors": ["dep-001", "met-002"],
    "acceptable_remediations": [
      "Restore route53:ChangeResourceRecordSets and route53:GetChange to cert-renewer-role, then trigger a renewal immediately",
      "Manually issue and install a new certificate for api.example.com, then fix the renewer's IAM permissions"
    ]
  },
  "budget": {"max_steps": 20, "max_tokens": 80000}
}
