  "ground_truth": {
    "root_cause": "dependency_slowdown",
    "summary": "The external payments provider degraded and charge calls went from ~300ms to 9-13s. order-service makes that call inside the database transaction in placeOrder, so each slow charge held a DB connection for its full duration. All 40 pooled connections were soon held, and every endpoint, including reads that never touch payments, timed out waiting for a connection. The database itself was healthy and traffic was within normal range.",
    "affected_service": "order-service",
    "required_evidence": [["met-003", "log-003", "log-007", "log-002"], ["log-004", "met-002", "log-005"], ["log-008"]],
    "distractors": ["dep-001", "met-005", "met-004", "log-006"],
    "acceptable_remediations": [
      "Move the payments gateway call outside the database transaction so connections are not held while waiting on it",
      "Lower PAYMENTS_TIMEOUT_MS and put a circuit breaker on the payments gateway so slow charges fail fast",
      "Temporarily queue or shed new payment attempts until the provider recovers"
    ]
  },
  "budget": {"max_steps": 15, "max_tokens": 60000}
}
